# Copy this file to .env.thingsboard and fill in your values, then:
#   source .env.thingsboard
#   ./run_stack.sh

# ── Required ───────────────────────────────────────────────
# Your device access token from ThingsBoard
# (Devices → your device → Copy access token)
export TB_ACCESS_TOKEN="REPLACE_WITH_DEVICE_ACCESS_TOKEN"

# ── ThingsBoard host ───────────────────────────────────────
export TB_HOST="demo.thingsboard.io"   # or your self-hosted IP / domain
export TB_USE_HTTPS="true"             # set to "false" for local HTTP instances
export TB_HTTP_TIMEOUT_SEC="5"

# ── ESP32 feedback ─────────────────────────────────────────
# IP of the ESP32 on your local network (shown in Serial Monitor after boot)
# Leave empty to disable feedback loop
export ESP32_URL="172.24.130.139"
export ESP32_PORT="8080"
